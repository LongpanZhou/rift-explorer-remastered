{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rift Explorer Remastered",
  "version": "0.1.8",
  "identifier": "com.riftexplorer.remastered",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rift Explorer Remastered",
        "width": 1100,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/profile-icons/**", "$APPCACHE/skin-art/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/lcu-sidecar",
      "binaries/ascii-image-converter"
    ],
    "resources": [
      "../third_party/ascii-image-converter/LICENSE.txt"
    ],
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}